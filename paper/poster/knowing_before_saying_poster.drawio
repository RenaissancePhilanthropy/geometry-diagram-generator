<mxfile host="Electron" modified="2026-10-25T00:00:00.000Z" agent="poster-gen" version="24.7.17" type="device"><diagram name="poster" id="poster"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2402" pageHeight="3346" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2402" height="3346" as="geometry"/></mxCell>
<mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="50" width="2302" height="320" as="geometry"/></mxCell>
<mxCell id="c4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#131318;strokeColor=none;strokeWidth=0;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="380" height="200" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="100" y="187.0" width="340" height="46" as="geometry"/></mxCell>
<mxCell id="c6" value="Renaissance&lt;br&gt;Philanthropy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="190" y="110" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="c7" value="MATH-AI 2026&lt;br&gt;at NeurIPS&lt;br&gt;&lt;span style='font-size:20px;color:#737382'&gt;logo to add&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=26;fontFamily=Helvetica;fontColor=#131318;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1942" y="110" width="380" height="200" as="geometry"/></mxCell>
<mxCell id="c8" value="Knowing Before Saying:&lt;br&gt;Internal Correctness Signals in Mathematical Reasoning" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=48;fontFamily=Helvetica;fontColor=#131318;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="1422" height="190" as="geometry"/></mxCell>
<mxCell id="c9" value="Mei Chen¹ · Gordon Stein¹ · Andreas Ziegler²" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=36;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="1422" height="60" as="geometry"/></mxCell>
<mxCell id="c10" value="¹Renaissance Philanthropy   ²Institute for Aerospace Studies, University of Toronto" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=26;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="490" y="305" width="1422" height="50" as="geometry"/></mxCell>
<mxCell id="c11" value="Open models carry a signal about their own errors that their stated confidence does not.&lt;br&gt;A linear probe on the hidden state reads it." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;strokeWidth=0;fontSize=38;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="2302" height="120" as="geometry"/></mxCell>
<mxCell id="c12" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c13" value="The problem" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="134" y="554" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c15" value="A confidently wrong answer is a problem. On MATH a wrong derivation looks exactly like a right one, so nothing on the page gives it away." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="668" width="1126" height="90" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;One real attempt. Mistral on MATH.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;What integer n satisfies 0 ≤ n &amp;lt; 18 and n ≡ −11213141 (mod 18)?&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style='color:#737382'&gt;Before answering:&lt;/span&gt; &amp;nbsp;&lt;b&gt;Confidence 90&lt;/b&gt;&lt;br&gt;&lt;br&gt;r = −11213141 − 18 × (−622953)&lt;br&gt;r = −11213141 + 11213154&lt;br&gt;r = &lt;span style='color:#D04A3A;font-weight:bold'&gt;3&lt;/span&gt; &amp;nbsp;&amp;nbsp;&lt;span style='color:#737382'&gt;(it is 13)&lt;/span&gt;&lt;br&gt;So n = 3.&lt;br&gt;&lt;br&gt;&lt;span style='color:#737382'&gt;After answering:&lt;/span&gt; &amp;nbsp;&lt;b&gt;Confidence 95&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#131318;strokeWidth=4;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=left;verticalAlign=top;spacing=30;" vertex="1" parent="1"><mxGeometry x="50" y="772" width="1126" height="580" as="geometry"/></mxCell>
<mxCell id="c17" value="Model says&lt;br&gt;&lt;span style='font-size:44px'&gt;95 / 100&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#737382;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="1382" width="540" height="120" as="geometry"/></mxCell>
<mxCell id="c18" value="Probe on the hidden state&lt;br&gt;&lt;span style='font-size:44px'&gt;likely wrong&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="636" y="1382" width="540" height="120" as="geometry"/></mxCell>
<mxCell id="c19" value="Every step is right until the last subtraction. The slip leaves no mark. Confidence went up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="1518" width="1126" height="70" as="geometry"/></mxCell>
<mxCell id="c20" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1608" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c21" value="What is new" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="134" y="1602" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c22" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="1688" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c23" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;12 / 16&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;model–task cells where the probe beats stated confidence. One tie.&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="1716" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c24" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;+0.20&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;AUROC gap on MATH, the largest of the four tasks. Mean gap 0.10.&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="636" y="1716" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c25" value='&lt;span style="font-size:56px;font-weight:bold;color:#F87248"&gt;0.84 → 0.56&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;stated confidence on Mistral once the probed direction is erased&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="1932" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c26" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;4&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;open models: Gemma-4, Qwen3.6, GLM-4.7, Mistral&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="636" y="1932" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c27" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="2162" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c28" value="How we read the state" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="134" y="2156" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="2242" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c30" value="Three turns. We record the hidden state at the token where the model is about to write its confidence digit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="2270" width="1126" height="70" as="geometry"/></mxCell>
<mxCell id="c31" value="&lt;b&gt;Turn 1&lt;/b&gt; &amp;nbsp;“How confident are you that you will get this right? 0–100.”&lt;br&gt;Model writes a number." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="2356" width="1126" height="104" as="geometry"/></mxCell>
<mxCell id="c32" value="&lt;b&gt;Turn 2&lt;/b&gt; &amp;nbsp;The model answers the question." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="2504" width="1126" height="96" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;Turn 3&lt;/b&gt; &amp;nbsp;“How confident are you that the answer you just gave is correct?”&lt;br&gt;&lt;span style='color:#F87248;font-weight:bold'&gt;▲ read site: the hidden state as it writes the digit&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1EB;strokeColor=#F87248;strokeWidth=4;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="2644" width="1126" height="110" as="geometry"/></mxCell>
<mxCell id="c34" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c35" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b&gt;The probe.&lt;/b&gt; Standardize, 50 principal components, logistic regression. Five folds grouped by question, so the probe is scored only on questions it never saw." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="2784" width="1126" height="90" as="geometry"/></mxCell>
<mxCell id="c37" value="&lt;b&gt;The intervention.&lt;/b&gt; At that same token, after the answer is written, scale the state along the correctness direction by a gain g. A random direction of the same norm is the control." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="2888" width="1126" height="110" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b&gt;g = 0&lt;/b&gt;&lt;br&gt;erased" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1EB;strokeColor=#F87248;strokeWidth=4;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="3022" width="262" height="100" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;g = 1&lt;/b&gt;&lt;br&gt;untouched" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="338" y="3022" width="262" height="100" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b&gt;g = 2&lt;/b&gt;&lt;br&gt;doubled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="626" y="3022" width="262" height="100" as="geometry"/></mxCell>
<mxCell id="c41" value="&lt;b&gt;g = 4&lt;/b&gt;&lt;br&gt;quadrupled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="914" y="3022" width="262" height="100" as="geometry"/></mxCell>
<mxCell id="c42" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1226" y="560" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c43" value="What we found" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1310" y="554" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c44" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="1226" y="640" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c45" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1226" y="668" width="1126" height="521" as="geometry"/></mxCell>
<mxCell id="c46" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="1205" width="1126" height="170" as="geometry"/></mxCell>
<mxCell id="c47" value="&lt;b&gt;12 / 16&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=52;fontFamily=Helvetica;fontColor=#F87248;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1246" y="1205" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="c48" value="&lt;b&gt;The state carries more than the report.&lt;/b&gt; The probe beats stated confidence in 12 of 16 cells. Mean gap 0.10. On MATH, 0.20." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1566" y="1221" width="756" height="138" as="geometry"/></mxCell>
<mxCell id="c49" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1369.0" y="1401" width="840" height="653" as="geometry"/></mxCell>
<mxCell id="c50" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="2070" width="1126" height="200" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;0.84&lt;br&gt;→ 0.56&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=48;fontFamily=Helvetica;fontColor=#F87248;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1246" y="2070" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b&gt;On Mistral, the report uses the signal.&lt;/b&gt; Erase the direction and stated confidence stops separating right from wrong. A random direction does nothing. The model becomes uniformly sure, not confused." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1566" y="2086" width="756" height="168" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;Not every model.&lt;/b&gt; On GLM, erasing changes nothing. On Qwen3.6 the self-report is nearly flat to begin with, so there is nothing to erase. Gemma-4 leaves too few failures to test." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1226" y="2290" width="1126" height="100" as="geometry"/></mxCell>
<mxCell id="c54" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1226" y="2410" width="600" height="367" as="geometry"/></mxCell>
<mxCell id="c55" value="&lt;b&gt;Where in the network.&lt;/b&gt; Fixed in advance at 70% of depth, for every model and every cell.&lt;br&gt;&lt;br&gt;&lt;span style='color:#737382;font-size:26px'&gt;Probe AUROC by depth on MATH. Layer 0 is chance because its token is identical in every record. The signal is present from the first layers and flat across depth. The dot is the fixed layer.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1856" y="2410" width="496" height="367" as="geometry"/></mxCell>
<mxCell id="c56" value="&lt;b&gt;Four open models carry information about their own errors that their self-report does not.&lt;br&gt;In Mistral, we have shown it is used when it self-reports.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1EB;strokeColor=#F87248;strokeWidth=5;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="3086" width="1126" height="210" as="geometry"/></mxCell>
<mxCell id="c57" value="QR code&lt;br&gt;&lt;span style='font-size:22px;color:#737382'&gt;to add&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=26;fontFamily=Helvetica;fontColor=#131318;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="2846" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="c58" value="Code, prompts, and every per-cell number.&lt;br&gt;&lt;span style='color:#737382'&gt;Repository link to be added.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1456" y="2846" width="896" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>