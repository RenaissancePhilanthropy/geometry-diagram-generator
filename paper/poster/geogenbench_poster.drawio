<mxCell id="c6" value="Renaissance&lt;br&gt;Philanthropy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="190" y="110" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="c7" value="MATH-AI 2026&lt;br&gt;at NeurIPS&lt;br&gt;&lt;span style='font-size:20px;color:#737382'&gt;logo to add&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=26;fontFamily=Helvetica;fontColor=#131318;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1942" y="110" width="380" height="200" as="geometry"/></mxCell>
<mxCell id="c8" value="GeoGenBench: Symbolically Verified&lt;br&gt;Generation of Geometry Diagrams" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=62;fontFamily=Helvetica;fontColor=#131318;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="1422" height="190" as="geometry"/></mxCell>
<mxCell id="c9" value="Mei Chen · Gordon Stein" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=36;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="1422" height="60" as="geometry"/></mxCell>
<mxCell id="c10" value="Renaissance Philanthropy" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=26;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="490" y="305" width="1422" height="50" as="geometry"/></mxCell>
<mxCell id="c11" value="A geometry drawing can be graded exactly from its coordinates, with no judge.&lt;br&gt;Graded this way, the scaffold matters more than the model." style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;strokeWidth=0;fontSize=38;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="2302" height="120" as="geometry"/></mxCell>
<mxCell id="c12" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c13" value="The problem" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="134" y="554" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c14" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c15" value="Every geometry benchmark asks a model to read a diagram. None asks it to draw one, because grading a drawing has been the hard part." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="668" width="1126" height="90" as="geometry"/></mxCell>
<mxCell id="c16" value="Both drawings below answer: &lt;i&gt;“Draw an acute triangle ABC with 60° at B and 70° at C. Drop the altitude from A to BC, meeting it at H.”&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="768" width="1126" height="80" as="geometry"/></mxCell>
<mxCell id="c17" value="PASS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2F9E6E;strokeColor=none;strokeWidth=0;fontSize=30;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="220.0" y="858" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="c18" value="FAIL" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#D04A3A;strokeColor=none;strokeWidth=0;fontSize=30;fontFamily=Helvetica;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="806.0" y="858" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="c19" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F9E6E;strokeWidth=4;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="942" width="540" height="400" as="geometry"/></mxCell>
<mxCell id="c20" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D04A3A;strokeWidth=4;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="636" y="942" width="540" height="400" as="geometry"/></mxCell>
<mxCell id="c21" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="147.0" y="962" width="346" height="360" as="geometry"/></mxCell>
<mxCell id="c22" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="661" y="960.0" width="490" height="364" as="geometry"/></mxCell>
<mxCell id="c23" value="60° at B, 70° at C, altitude from A, foot H on BC. Every check holds." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="1356" width="540" height="110" as="geometry"/></mxCell>
<mxCell id="c24" value="Obtuse at B, so H lands outside BC. The right angle is still there. A person glancing at it would likely pass it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="636" y="1356" width="540" height="110" as="geometry"/></mxCell>
<mxCell id="c25" value="Looking right is not the same as being right." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=36;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="1476" width="1126" height="56" as="geometry"/></mxCell>
<mxCell id="c26" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1566" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c27" value="What is new" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="134" y="1560" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c28" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="1646" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c29" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;801&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;prompts, each paired with the checks a correct drawing must pass&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="1674" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c30" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;15&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;checks, each a few lines of arithmetic. No human, no vision judge&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="636" y="1674" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c31" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;6&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;frontier models. A typed scaffold lifts every one, by 2 to 25 points&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="1890" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c32" value='&lt;span style="font-size:64px;font-weight:bold;color:#F87248"&gt;0&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:27px;color:#131318"&gt;correct drawings failed by the grader in a 200-output human audit&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="636" y="1890" width="540" height="180" as="geometry"/></mxCell>
<mxCell id="c33" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="2120" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c34" value="How a drawing is graded" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="134" y="2114" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c35" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="2200" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b&gt;One template writes both.&lt;/b&gt; A Python function emits the sentence the model sees and the checks the grader runs, from the same variables, so the two cannot disagree." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="2228" width="1126" height="100" as="geometry"/></mxCell>
<mxCell id="c37" value="altitude_template(A, B, C, H, 60°, 70°)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=#B8B8C0;strokeWidth=2;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="253.0" y="2358" width="720" height="84" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b&gt;Prompt&lt;/b&gt;, shown to the model&lt;br&gt;&lt;span style='font-size:26px'&gt;“Draw an acute triangle ABC with 60° at B and 70° at C. Drop the altitude from A to BC, meeting it at H.”&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#131318;strokeWidth=3;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="2492" width="540" height="220" as="geometry"/></mxCell>
<mxCell id="c39" value="&lt;b&gt;Checks&lt;/b&gt;, never shown&lt;br&gt;&lt;span style='font-family:monospace;font-size:26px'&gt;right_angle(A, H, B)&lt;br&gt;point_on_segment(H, B, C)&lt;br&gt;mark_present(right_angle, H)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1EB;strokeColor=#F87248;strokeWidth=4;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="636" y="2492" width="540" height="220" as="geometry"/></mxCell>
<mxCell id="c40" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c41" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c37" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b&gt;From drawing to verdict.&lt;/b&gt; The model writes TikZ. We parse the coordinates back out of it and run the checks on them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="2742" width="1126" height="70" as="geometry"/></mxCell>
<mxCell id="c43" value="model writes&lt;br&gt;&lt;b&gt;TikZ&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="2828" width="262" height="110" as="geometry"/></mxCell>
<mxCell id="c44" value="parse&lt;br&gt;&lt;b&gt;coordinates&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="338" y="2828" width="262" height="110" as="geometry"/></mxCell>
<mxCell id="c45" value="run the&lt;br&gt;&lt;b&gt;checks&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1EB;strokeColor=#F87248;strokeWidth=4;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="626" y="2828" width="262" height="110" as="geometry"/></mxCell>
<mxCell id="c46" value="&lt;b&gt;pass&lt;/b&gt; · soft pass&lt;br&gt;· fail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="914" y="2828" width="262" height="110" as="geometry"/></mxCell>
<mxCell id="c47" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c48" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c49" style="endArrow=block;endFill=1;strokeWidth=4;strokeColor=#131318;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="c50" value="Fifteen checks such as right angle, midpoint, parallel, and point on segment, each arithmetic with a small tolerance. &lt;b&gt;A right angle is a dot product, not an opinion.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="2968" width="1126" height="100" as="geometry"/></mxCell>
<mxCell id="c51" value="&lt;b&gt;600 prompts&lt;/b&gt; from 30 templates, 200 per tier, plus &lt;b&gt;201&lt;/b&gt; from a K–12 curriculum." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=30;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="50" y="3084" width="1126" height="44" as="geometry"/></mxCell>
<mxCell id="c52" value="&lt;b&gt;T1&lt;/b&gt;&lt;br&gt;a single shape" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="3144" width="358" height="96" as="geometry"/></mxCell>
<mxCell id="c53" value="&lt;b&gt;T2&lt;/b&gt;&lt;br&gt;adds one construction" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="434" y="3144" width="358" height="96" as="geometry"/></mxCell>
<mxCell id="c54" value="&lt;b&gt;T3&lt;/b&gt;&lt;br&gt;combines several" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=28;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="818" y="3144" width="358" height="96" as="geometry"/></mxCell>
<mxCell id="c55" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1226" y="560" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c56" value="What we found" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1310" y="554" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c57" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="1226" y="640" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c58" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1259.0" y="668" width="1060" height="620" as="geometry"/></mxCell>
<mxCell id="c59" value="Strict pass rate on 600 templated prompts, 3 repeats. Dashed box: three models within one point of each other at a 7× cost spread." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1226" y="1294" width="1126" height="70" as="geometry"/></mxCell>
<mxCell id="c60" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="1380" width="1126" height="156" as="geometry"/></mxCell>
<mxCell id="c61" value="&lt;b&gt;+2 to +25&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=52;fontFamily=Helvetica;fontColor=#F87248;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1246" y="1380" width="300" height="156" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;The scaffold lifts every model.&lt;/b&gt; The weaker a model is at raw TikZ, the more it gains." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1566" y="1396" width="756" height="124" as="geometry"/></mxCell>
<mxCell id="c63" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="1556" width="1126" height="156" as="geometry"/></mxCell>
<mxCell id="c64" value="&lt;b&gt;1 point&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=52;fontFamily=Helvetica;fontColor=#F87248;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1246" y="1556" width="300" height="156" as="geometry"/></mxCell>
<mxCell id="c65" value="&lt;b&gt;The frontier converges.&lt;/b&gt; GPT-5.5, Sonnet, and Opus finish within one point. Opus costs seven times more." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1566" y="1572" width="756" height="124" as="geometry"/></mxCell>
<mxCell id="c66" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="1732" width="1126" height="156" as="geometry"/></mxCell>
<mxCell id="c67" value="&lt;b&gt;92 → 36%&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=52;fontFamily=Helvetica;fontColor=#F87248;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1246" y="1732" width="300" height="156" as="geometry"/></mxCell>
<mxCell id="c68" value="&lt;b&gt;Without the scaffold&lt;/b&gt; the same six models spread across 56 points." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=29;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1566" y="1748" width="756" height="124" as="geometry"/></mxCell>
<mxCell id="c69" value="&lt;b&gt;Wrong drawings, not broken code.&lt;/b&gt; Most failures are clean, rendered diagrams with the wrong geometry. The grader catches them. A person glancing at the picture often would not." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1226" y="1918" width="1126" height="100" as="geometry"/></mxCell>
<mxCell id="c70" value="&lt;b&gt;Limits.&lt;/b&gt; The top models are near the ceiling on T1 and T2. On the curriculum prompts every score we ran roughly halved. The scaffold bundles format, compile path, and retries; we have not separated them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1226" y="2048" width="1126" height="100" as="geometry"/></mxCell>
<mxCell id="c71" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F87248;strokeColor=none;fontColor=#FFFFFF;fontSize=36;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1226" y="2168" width="64" height="64" as="geometry"/></mxCell>
<mxCell id="c72" value="Can the grader be trusted" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=46;fontFamily=Helvetica;fontColor=#F87248;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1310" y="2162" width="1042" height="76" as="geometry"/></mxCell>
<mxCell id="c73" value="" style="line;strokeWidth=4;strokeColor=#F87248;html=1;" vertex="1" parent="1"><mxGeometry x="1226" y="2248" width="1126" height="6" as="geometry"/></mxCell>
<mxCell id="c74" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1226" y="2276" width="640" height="398" as="geometry"/></mxCell>
<mxCell id="c75" value="&lt;span style=&quot;font-size:64px;font-weight:bold;color:#F87248&quot;&gt;18%&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:27px;color:#131318&quot;&gt;of the grader's &lt;b&gt;passes&lt;/b&gt; overturned by two blind raters&lt;br&gt;&lt;br&gt;&lt;span style='font-size:64px;font-weight:bold;color:#F87248'&gt;0%&lt;/span&gt;&lt;br&gt;of its &lt;b&gt;fails&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;strokeWidth=0;fontSize=27;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="1896" y="2276" width="456" height="398" as="geometry"/></mxCell>
<mxCell id="c76" value="The disagreement sits in one tier, T2, where the templates check the construction but not the angles the prompt gave." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=27;fontFamily=Helvetica;fontColor=#737382;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1226" y="2684" width="1126" height="70" as="geometry"/></mxCell>
<mxCell id="c77" value="&lt;b&gt;Each requirement on a drawing can be checked exactly, from its coordinates.&lt;br&gt;Graded this way, the scaffold matters more than the model.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1EB;strokeColor=#F87248;strokeWidth=5;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="3086" width="1126" height="210" as="geometry"/></mxCell>
<mxCell id="c78" value="QR code&lt;br&gt;&lt;span style='font-size:22px;color:#737382'&gt;to add&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8B8C0;strokeWidth=2;fontSize=26;fontFamily=Helvetica;fontColor=#131318;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1226" y="2846" width="200" height="200" as="geometry"/></mxCell>
<mxCell id="c79" value="Prompts, templates, grader, and leaderboard.&lt;br&gt;&lt;span style='color:#737382'&gt;Release link to be added.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=32;fontFamily=Helvetica;fontColor=#131318;fontStyle=0;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1456" y="2846" width="896" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>