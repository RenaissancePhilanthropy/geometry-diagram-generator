# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Node.js dependencies
node_modules/
.pnpm-store/

# Local environment
.env
demo-ui/pnpm-workspace.yaml

# LLM agent state and cache
.claude/*
# Allow skills (negation only works if parent isn't fully ignored)
!.claude/skills/

# Evals results
evals/results/
# Embedding judge outputs (runs.jsonl, matrix.csv, cache, etc.) — default and
# per-embedding-model variants (e.g. evals/embedding_judge_out_qwene4b/).
evals/embedding_judge_out*/

# macOS files
.DS_Store

# Git worktrees
.worktrees/

# Superpowers plans
docs/superpowers/

# Temporary files
tmp/

# Curriculum extraction artifacts
curriculum/textbooks/
curriculum/markdown/
curriculum/.marker-venv/
curriculum/geometry_curriculum.json
curriculum/*_raw.txt
curriculum/debug_*.txt
curriculum/*.log
curriculum/*.zip

# Benchmark run data
benchmark/data/

# GEPA optimization run data (logs + candidate outputs)
gepa_runs/

# Vim swap files
*.swp
*.swo

# Eval run console captures / test run logs
output_run_*.txt
output_run_*.log
test_run*.txt
nohup.out
ollama_run.txt

# Scratch / conversation dumps / personal notes / PDFs
2026-05-20-*.txt
command_smoke_scenarios.txt
project_discovery.md
geogenbench_1.pdf

# Generated scenario-id lists
evals/*_scenario_list.txt

# Extra eval results dir (evals/results/ is already ignored above)
evals/results_smoke_glm3/
